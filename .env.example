# Set these as Environment Variables in the Vercel project dashboard —
# never commit real values here, and never prefix any of these with
# NEXT_PUBLIC_ or anything else that would expose them to the browser.

FTM_ENGINE_URL=https://api.ftmwealthnation.com
FTM_WEBSITE_API_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> Add endpoint
#   URL: https://www.ftmwealthnation.com/api/stripe/webhook
#   Event: checkout.session.completed
# Stripe then shows a signing secret (whsec_...) — that's this value.
STRIPE_WEBHOOK_SECRET=

# Optional — defaults to https://www.ftmwealthnation.com if unset.
SITE_URL=
