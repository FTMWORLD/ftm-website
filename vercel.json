{
  "redirects": [
    {
      "source": "/HANDOFF.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_keyed_english.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_langs.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CLAUDE.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/v1/brevo-ping",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/v1/status?alert=1",
      "schedule": "0 7 * * *"
    }
  ]
}
