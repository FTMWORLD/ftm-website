{
  "redirects": [
    {
      "source": "/HANDOFF.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_keyed_english.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_langs.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CLAUDE.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/v1/brevo-ping",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/v1/status?alert=1",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/customer/:first(chat|investment|investments|leaderboard|market)/:rest*",
      "destination": "/api/v1/customer/proxy?__p=:first/:rest*"
    },
    {
      "source": "/api/v1/customer/:first(chat|investment|leaderboard)",
      "destination": "/api/v1/customer/proxy?__p=:first"
    }
  ]
}
