{
  "redirects": [
    {
      "source": "/HANDOFF.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_keyed_english.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/i18n/_langs.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CLAUDE.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/v1/brevo-ping",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/v1/status?alert=1",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/v1/letter-cron",
      "schedule": "23 9 * * *"
    },
    {
      "path": "/api/v1/news-cron",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/v1/news-cron",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/customer/:first(chat|investment|investments|leaderboard|market|kyc-profile)/:rest*",
      "destination": "/api/v1/customer/proxy?__p=:first/:rest*"
    },
    {
      "source": "/api/v1/customer/:first(chat|investment|leaderboard|kyc-profile)",
      "destination": "/api/v1/customer/proxy?__p=:first"
    },
    {
      "source": "/p/:id",
      "destination": "/api/v1/community?share=:id"
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/v1/staff.js": {
      "maxDuration": 60
    },
    "api/v1/community.js": {
      "maxDuration": 30
    },
    "api/v1/letter-cron.js": {
      "maxDuration": 60
    },
    "api/v1/news-cron.js": {
      "maxDuration": 60
    }
  }
}
